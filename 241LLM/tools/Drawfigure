try:
    # 从Google Drive读取文件内容
    with open(file_path, 'r', encoding='utf-8') as f:
        doc_content = f.read()
    print(f"成功读取文件: {file_path}")
except Exception as e:
    print(f"读取文件时出错: {e}")

# 使用正则表达式提取数据
round_pattern = r'\[📊 Agent_0 \| 回合 (\d+)\] 最近 \d+ 回合性能摘要:'
bp_pattern = r'- 平均阻塞率 \(BP\)\s+:\s+(-?\d+\.\d+)'
value_pattern = r'- 平均评估价值 \(V\)\s+:\s+(-?\d+\.\d+)'
reward_pattern = r'- 平均回合奖励 \(R\)\s+:\s+(-?\d+\.\d+)'
value_loss_pattern = r'- 最近批次价值损失\s+:\s+(-?\d+\.\d+)'
policy_loss_pattern = r'- 最近批次策略损失\s+:\s+(-?\d+\.\d+)'
entropy_pattern = r'- 最近批次熵\s+:\s+(-?\d+\.\d+)'


rounds = []
bps = []
values = []
rewards = []
value_losses = []
policy_losses = []
entropies = []


# Split the content by the round pattern to process each round's data
round_blocks = re.split(round_pattern, doc_content)

# Process the split content, skipping the first element which is everything before the first round
for i in range(1, len(round_blocks), 2):
    round_num_str = round_blocks[i].strip()
    content_after_round = round_blocks[i+1]

    try:
        round_num = int(round_num_str)

        bp_match = re.search(bp_pattern, content_after_round)
        val_match = re.search(value_pattern, content_after_round)
        reward_match = re.search(reward_pattern, content_after_round)
        value_loss_match = re.search(value_loss_pattern, content_after_round)
        policy_loss_match = re.search(policy_loss_pattern, content_after_round)
        entropy_match = re.search(entropy_pattern, content_after_round)


        if bp_match and val_match and reward_match and value_loss_match and policy_loss_match and entropy_match:
            bp = float(bp_match.group(1))
            val = float(val_match.group(1))
            reward = float(reward_match.group(1))
            value_loss = float(value_loss_match.group(1))
            policy_loss = float(policy_loss_match.group(1))
            entropy = float(entropy_match.group(1))


            rounds.append(round_num)
            bps.append(bp)
            values.append(val)
            rewards.append(reward)
            value_losses.append(value_loss)
            policy_losses.append(policy_loss)
            entropies.append(entropy)

        else:
            print(f"警告: 回合 {round_num} 的数据解析失败")

    except ValueError:
        print(f"警告: 无法解析回合数 '{round_num_str}'")
    except Exception as e:
        print(f"警告: 处理回合数据时发生错误: {e}")


# 绘制折线图
plt.figure(figsize=(12, 8))

# 绘制折线
plt.plot(rounds, bps, label='Average Blocking Rate (BP)', color='red', linewidth=2)
plt.plot(rounds, values, label='Average Evaluation Value (V)', color='blue', linewidth=2)
plt.plot(rounds, rewards, label='Average Round Reward (R)', color='green', linewidth=2)
plt.plot(rounds, value_losses, label='Recent Batch Value Loss', color='purple', linewidth=2)
plt.plot(rounds, policy_losses, label='Recent Batch Policy Loss', color='orange', linewidth=2)
plt.plot(rounds, entropies, label='Recent Batch Entropy', color='brown', linewidth=2)


# 设置图表属性
plt.xlim(0, 5000)
plt.xlabel('Epoch', fontsize=12)
plt.ylabel('Score', fontsize=12)
plt.title('Agent_0 Performance indicator trend chart', fontsize=15)
